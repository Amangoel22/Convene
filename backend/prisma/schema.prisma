// Prisma Schema for Convene - Multi-Tenant Event Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// 1. USERS & GLOBAL ACCOUNTS
// =============================================================
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  eventMemberships     EventMembership[]
  orgAccess            OrgAccess[]
  orgMemberProfile     OrgMember[]          // a User may have an org-member person record
  participantTeamRoles ParticipantTeamMember[]
  participantInfo      EventParticipant[]
  uploadedResources    EventResource[]
  dutyAssignments      DutyAssignment[]
  reportedIssues       Issue[]              @relation("IssueReporter")
  assignedIssues       Issue[]              @relation("IssueAssignee")

  @@map("users")
}

// =============================================================
// 2. EVENTS (Central Scope Boundary)
// =============================================================
model Event {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  type            String   @db.VarChar(50)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  startTime       String   @map("start_time") @db.VarChar(30)
  endTime         String   @map("end_time") @db.VarChar(30)
  durationDisplay String?  @map("duration_display") @db.VarChar(100)
  primaryLocation String?  @map("primary_location") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  memberships      EventMembership[]
  orgTeams         OrgTeam[]
  orgAccess        OrgAccess[]
  participantTeams ParticipantTeam[]
  participants     EventParticipant[]
  resources        EventResource[]
  stages           Stage[]
  tasks            Task[]
  duties           Duty[]
  dutyAssignments  DutyAssignment[]
  issues           Issue[]

  @@map("events")
}

// =============================================================
// 3. EVENT MEMBERSHIPS — broad gate (organizer | participant)
// =============================================================
enum MembershipRole {
  organizer
  participant
}

model EventMembership {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @map("event_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "unique_event_user")
  @@index([userId])
  @@index([eventId])
  @@map("event_memberships")
}

// =============================================================
// 4. PARTICIPANT SIDE — Teams & Members
// =============================================================

// Participating teams (e.g. "Team Alpha", "Batch 2023-CS")
model ParticipantTeam {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String   @db.VarChar(255)
  teamCode    String   @map("team_code") @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  event   Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members ParticipantTeamMember[]

  @@unique([eventId, teamCode], name: "unique_event_participant_team_code")
  @@index([eventId])
  @@map("participant_teams")
}

enum ParticipantTeamRole {
  lead
  member
}

model ParticipantTeamMember {
  id                String              @id @default(uuid()) @db.Uuid
  participantTeamId String              @map("participant_team_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  role              ParticipantTeamRole @default(member)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz

  participantTeam ParticipantTeam @relation(fields: [participantTeamId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([participantTeamId, userId], name: "unique_participant_team_user")
  @@index([userId])
  @@index([participantTeamId])
  @@map("participant_team_members")
}

// =============================================================
// 5. ORGANISING SIDE — Teams, Members & Access Control
// =============================================================

// Org teams are event-scoped and creator-defined (Design, Tech, Logistics…).
// Unique per (eventId, name) — Design of Event 1 is not visible in Event 2.
model OrgTeam {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String   @db.VarChar(100) // e.g. "Design", "Tech & AV", "Logistics"
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members OrgMember[]
  tasks   Task[]
  duties  Duty[]
  stages  Stage[]

  @@unique([eventId, name], name: "unique_event_org_team_name")
  @@index([eventId])
  @@map("org_teams")
}

// Org member — the actual person record (name + phone).
// Optionally linked to a User account (userId nullable).
// A person can be added by the event manager without an app account.
model OrgMember {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  orgTeamId String   @map("org_team_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid // nullable — links to app account if they have one
  name      String   @db.VarChar(150)
  phone     String?  @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  orgTeam OrgTeam @relation(fields: [orgTeamId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks   Task[]

  // A User can only have one org-member record per event
  @@unique([eventId, userId], name: "unique_event_org_member_user")
  @@index([eventId])
  @@index([orgTeamId])
  @@index([userId])
  @@map("org_members")
}

// Fine-grained access level for org members who have a User account.
// Sits alongside EventMembership (role=organizer is the gate; this gives lead/member distinction).
enum OrgAccessLevel {
  lead
  member
}

model OrgAccess {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  accessLevel OrgAccessLevel @default(member) @map("access_level")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "unique_event_org_access")
  @@index([eventId])
  @@index([userId])
  @@map("org_access")
}

// =============================================================
// 6. EVENT PARTICIPANTS & QR VERIFICATION
// =============================================================
enum CheckInStatus {
  Unconfirmed
  Confirmed
  Checked_In @map("Checked In")
  Rejected
}

model EventParticipant {
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  participantCode String?       @map("participant_code") @db.VarChar(50)
  qrToken         String        @unique @map("qr_token") @db.VarChar(255)
  checkInStatus   CheckInStatus @default(Unconfirmed) @map("check_in_status")
  internalNotes   String?       @map("internal_notes")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "unique_event_participant")
  @@index([eventId])
  @@index([userId])
  @@index([qrToken])
  @@map("event_participants")
}

// =============================================================
// 7. EVENT RESOURCES (Resource Vault)
// =============================================================
model EventResource {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  title          String   @db.VarChar(255)
  category       String   @db.VarChar(50)
  fileUrl        String   @map("file_url")
  fileType       String   @map("file_type") @db.VarChar(20)
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  uploadedUserId String?  @map("uploaded_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedUser User? @relation(fields: [uploadedUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("event_resources")
}

// =============================================================
// 8. STAGES (Run of Show)
// =============================================================
enum StageStatus {
  LIVE
  Upcoming
  Completed
}

model Stage {
  id         String      @id @default(uuid()) @db.Uuid
  eventId    String      @map("event_id") @db.Uuid
  stageOrder Int         @map("stage_order")
  title      String      @db.VarChar(255)
  timeWindow String      @map("time_window") @db.VarChar(100)
  location   String      @db.VarChar(255)
  orgTeamId  String?     @map("org_team_id") @db.Uuid // which org team owns this stage
  status     StageStatus @default(Upcoming)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgTeam OrgTeam? @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("stages")
}

// =============================================================
// 9. TASKS (assigned to org members of a specific org team)
// =============================================================
enum TaskStatus {
  Todo
  In_Progress @map("In Progress")
  Blocked
  Completed
}

enum PriorityLevel {
  Critical
  High
  Medium
  Low
}

model Task {
  id                  String        @id @default(uuid()) @db.Uuid
  eventId             String        @map("event_id") @db.Uuid
  title               String        @db.VarChar(255)
  description         String?
  orgTeamId           String?       @map("org_team_id") @db.Uuid       // team context
  assignedOrgMemberId String?       @map("assigned_org_member_id") @db.Uuid // who it's assigned to
  status              TaskStatus    @default(Todo)
  priority            PriorityLevel @default(Medium)
  assignedAt          DateTime      @default(now()) @map("assigned_at") @db.Timestamptz
  dueAt               DateTime?     @map("due_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  event              Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgTeam            OrgTeam?  @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)
  assignedOrgMember  OrgMember? @relation(fields: [assignedOrgMemberId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([orgTeamId])
  @@index([assignedOrgMemberId])
  @@map("tasks")
}

// =============================================================
// 10. DUTIES & DUTY ASSIGNMENTS (on-day duties)
// =============================================================
model Duty {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  title      String   @db.VarChar(255)
  timeWindow String   @map("time_window") @db.VarChar(100)
  location   String   @db.VarChar(255)
  orgTeamId  String?  @map("org_team_id") @db.Uuid // which org team is on this duty
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgTeam     OrgTeam?         @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)
  assignments DutyAssignment[]

  @@index([eventId])
  @@index([orgTeamId])
  @@map("duties")
}

model DutyAssignment {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  dutyId  String @map("duty_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  duty  Duty  @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dutyId, userId], name: "unique_duty_user")
  @@index([eventId])
  @@index([userId])
  @@map("duty_assignments")
}

// =============================================================
// 11. ISSUES
// =============================================================
enum IssueStatus {
  Open
  In_Progress @map("In Progress")
  Resolved
}

model Issue {
  id                          String        @id @default(uuid()) @db.Uuid
  eventId                     String        @map("event_id") @db.Uuid
  title                       String        @db.VarChar(255)
  description                 String?
  priority                    PriorityLevel @default(Medium)
  status                      IssueStatus   @default(Open)
  reporterUserId              String        @map("reporter_user_id") @db.Uuid
  assignedUserId              String?       @map("assigned_user_id") @db.Uuid
  mandatoryResolutionFeedback String?       @map("mandatory_resolution_feedback")
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt                  DateTime?     @map("resolved_at") @db.Timestamptz

  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporterUser User  @relation("IssueReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  assignedUser User? @relation("IssueAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([reporterUserId])
  @@map("issues")
}
