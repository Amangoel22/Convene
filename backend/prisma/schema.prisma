generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  eventMemberships     EventMembership[]
  orgAccess            OrgAccess[]
  orgMemberProfile     OrgMember[]
  participantTeamRoles ParticipantTeamMember[]
  participantInfo      EventParticipant[]
  uploadedResources    EventResource[]
  dutyAssignments      DutyAssignment[]
  reportedIssues       Issue[]              @relation("IssueReporter")
  assignedIssues       Issue[]              @relation("IssueAssignee")

  @@map("users")
}

model Event {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(255)
  type           String   @db.VarChar(50)
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  startTime      String   @map("start_time") @db.VarChar(30)
  endTime        String   @map("end_time") @db.VarChar(30)
  durationDisplay String? @map("duration_display") @db.VarChar(100)
  primaryLocation String?  @map("primary_location") @db.VarChar(255) // legacy display fallback
  primaryVenueId  String?  @map("primary_venue_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  primaryVenue     Venue?             @relation("PrimaryEventVenue", fields: [primaryVenueId], references: [id], onDelete: SetNull)
  venues           Venue[]            @relation("EventVenues")
  memberships      EventMembership[]
  orgTeams         OrgTeam[]
  orgAccess        OrgAccess[]
  participantTeams ParticipantTeam[]
  participants     EventParticipant[]
  resources        EventResource[]
  stages           Stage[]
  tasks            Task[]
  duties           Duty[]
  dutyAssignments  DutyAssignment[]
  issues           Issue[]

  @@index([primaryVenueId])
  @@map("events")
}

model Venue {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  address     String?
  mapUrl      String?  @map("map_url")
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  event         Event        @relation("EventVenues", fields: [eventId], references: [id], onDelete: Cascade)
  primaryEvents Event[]       @relation("PrimaryEventVenue")
  images        VenueImage[]
  stages        Stage[]
  duties        Duty[]

  @@unique([eventId, name], name: "unique_event_venue_name")
  @@index([eventId])
  @@map("venues")
}

model VenueImage {
  id        String   @id @default(uuid()) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  imageUrl  String   @map("image_url")
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, sortOrder])
  @@map("venue_images")
}

enum MembershipRole {
  organizer
  participant
}
model EventMembership {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role MembershipRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId], name: "unique_event_user")
  @@index([userId])
  @@map("event_memberships")
}

model ParticipantTeam {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  name String @db.VarChar(255)
  teamCode String @map("team_code") @db.VarChar(50)
  description String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members ParticipantTeamMember[]
  @@unique([eventId, teamCode], name: "unique_event_participant_team_code")
  @@index([eventId])
  @@map("participant_teams")
}
enum ParticipantTeamRole {
  lead
  member
}
model ParticipantTeamMember {
  id String @id @default(uuid()) @db.Uuid
  participantTeamId String @map("participant_team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role ParticipantTeamRole @default(member)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  participantTeam ParticipantTeam @relation(fields: [participantTeamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([participantTeamId, userId], name: "unique_participant_team_user")
  @@index([userId])
  @@map("participant_team_members")
}

model OrgTeam {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  name String @db.VarChar(100)
  description String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members OrgMember[]
  tasks Task[]
  stages Stage[]
  issues Issue[]
  @@unique([eventId, name], name: "unique_event_org_team_name")
  @@index([eventId])
  @@map("org_teams")
}
model OrgMember {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  orgTeamId String @map("org_team_id") @db.Uuid
  userId String? @map("user_id") @db.Uuid
  name String @db.VarChar(150)
  phone String? @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  orgTeam OrgTeam @relation(fields: [orgTeamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks Task[]
  @@unique([eventId, userId], name: "unique_event_org_member_user")
  @@index([eventId, orgTeamId])
  @@map("org_members")
}
enum OrgAccessLevel {
  lead
  member
}
model OrgAccess {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  accessLevel OrgAccessLevel @default(member) @map("access_level")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId], name: "unique_event_org_access")
  @@index([userId])
  @@map("org_access")
}

enum CheckInStatus {
  Unconfirmed
  Confirmed
  Checked_In @map("Checked In")
  Rejected
}
model EventParticipant {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  participantCode String? @map("participant_code") @db.VarChar(50)
  qrToken String @unique @map("qr_token") @db.VarChar(255)
  checkInStatus CheckInStatus @default(Unconfirmed) @map("check_in_status")
  internalNotes String? @map("internal_notes")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId], name: "unique_event_participant")
  @@index([eventId])
  @@map("event_participants")
}

model EventResource {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  title String @db.VarChar(255)
  category String @db.VarChar(50)
  fileUrl String @map("file_url")
  fileType String @map("file_type") @db.VarChar(20)
  fileSizeBytes BigInt? @map("file_size_bytes")
  uploadedUserId String? @map("uploaded_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedUser User? @relation(fields: [uploadedUserId], references: [id], onDelete: SetNull)
  @@index([eventId])
  @@map("event_resources")
}

enum StageStatus {
  LIVE
  Upcoming
  Completed
}
model Stage {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  stageOrder Int @map("stage_order")
  title String @db.VarChar(255)
  startAt DateTime @map("start_at") @db.Timestamptz
  endAt DateTime @map("end_at") @db.Timestamptz
  venueId String? @map("venue_id") @db.Uuid
  orgTeamId String? @map("org_team_id") @db.Uuid
  status StageStatus @default(Upcoming)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  orgTeam OrgTeam? @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)
  @@index([eventId, stageOrder])
  @@index([venueId])
  @@map("stages")
}

enum TaskStatus {
  Todo
  In_Progress @map("In Progress")
  Blocked
  Completed
}
enum PriorityLevel {
  Critical
  High
  Medium
  Low
}
model Task {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  title String @db.VarChar(255)
  description String?
  orgTeamId String? @map("org_team_id") @db.Uuid // optional context; assignment is not team-limited
  assignedOrgMemberId String? @map("assigned_org_member_id") @db.Uuid
  status TaskStatus @default(Todo)
  priority PriorityLevel @default(Medium)
  assignedAt DateTime? @map("assigned_at") @db.Timestamptz
  dueAt DateTime? @map("due_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgTeam OrgTeam? @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)
  assignedOrgMember OrgMember? @relation(fields: [assignedOrgMemberId], references: [id], onDelete: SetNull)
  @@index([eventId, status])
  @@index([assignedOrgMemberId])
  @@map("tasks")
}

enum DutyCategory {
  Registration
  Food
  Hospitality
  Logistics
  Technical
  Security
  GuestSupport
  Other
}
model Duty {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  title String @db.VarChar(255)
  category DutyCategory @default(Other)
  startAt DateTime @map("start_at") @db.Timestamptz
  endAt DateTime @map("end_at") @db.Timestamptz
  venueId String? @map("venue_id") @db.Uuid
  notes String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue Venue? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  assignments DutyAssignment[]
  @@index([eventId, category])
  @@index([venueId])
  @@map("duties")
}
model DutyAssignment {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  dutyId String @map("duty_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  duty Duty @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([dutyId, userId], name: "unique_duty_user")
  @@index([eventId, userId])
  @@map("duty_assignments")
}

enum IssueStatus {
  Open
  In_Progress @map("In Progress")
  Resolved
}
model Issue {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  orgTeamId String? @map("org_team_id") @db.Uuid
  title String @db.VarChar(255)
  description String?
  priority PriorityLevel @default(Medium)
  status IssueStatus @default(Open)
  reporterUserId String @map("reporter_user_id") @db.Uuid
  assignedUserId String? @map("assigned_user_id") @db.Uuid
  mandatoryResolutionFeedback String? @map("mandatory_resolution_feedback")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orgTeam OrgTeam? @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)
  reporterUser User @relation("IssueReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  assignedUser User? @relation("IssueAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  @@index([eventId, status])
  @@index([orgTeamId])
  @@map("issues")
}
