// Prisma Schema for Convene - Multi-Tenant Event Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. USERS & GLOBAL ACCOUNTS
// -------------------------------------------------------------
model User {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @db.VarChar(150)
  email            String            @unique @db.VarChar(255)
  passwordHash     String            @db.VarChar(255)
  phone            String?           @db.VarChar(30)
  avatarUrl        String?           @map("avatar_url")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  eventMemberships EventMembership[]
  teamMemberships  TeamMember[]
  participantInfo  EventParticipant[]
  uploadedResources EventResource[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  dutyAssignments  DutyAssignment[]
  reportedIssues   Issue[]           @relation("IssueReporter")
  assignedIssues   Issue[]           @relation("IssueAssignee")

  @@map("users")
}

// -------------------------------------------------------------
// 2. EVENTS (Central Scope Boundary)
// -------------------------------------------------------------
model Event {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(255)
  type            String            @db.VarChar(50)
  startDate       DateTime          @map("start_date") @db.Date
  endDate         DateTime          @map("end_date") @db.Date
  startTime       String            @map("start_time") @db.VarChar(30)
  endTime         String            @map("end_time") @db.VarChar(30)
  durationDisplay String?           @map("duration_display") @db.VarChar(100)
  primaryLocation String?           @map("primary_location") @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz

  // Relationships
  memberships     EventMembership[]
  teams           Team[]
  participants    EventParticipant[]
  resources       EventResource[]
  stages          Stage[]
  tasks           Task[]
  duties          Duty[]
  dutyAssignments DutyAssignment[]
  issues          Issue[]

  @@map("events")
}

// -------------------------------------------------------------
// 3. EVENT MEMBERSHIPS (No Status column)
// -------------------------------------------------------------
enum MembershipRole {
  organizer
  participant
}

model EventMembership {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @map("event_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "unique_event_user")
  @@index([userId])
  @@index([eventId])
  @@map("event_memberships")
}

// -------------------------------------------------------------
// 4. TEAMS & TEAM MEMBERS
// -------------------------------------------------------------
model Team {
  id          String       @id @default(uuid()) @db.Uuid
  eventId     String       @map("event_id") @db.Uuid
  name        String       @db.VarChar(255)
  teamCode    String       @map("team_code") @db.VarChar(50)
  description String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members TeamMember[]
  stages  Stage[]      @relation("StageOwnerTeam")
  tasks   Task[]       @relation("TaskOwnerTeam")

  @@unique([eventId, teamCode], name: "unique_event_team_code")
  @@index([eventId])
  @@map("teams")
}

enum TeamRole {
  lead
  member
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      TeamRole @default(member)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], name: "unique_team_user")
  @@index([userId])
  @@index([teamId])
  @@map("team_members")
}

// -------------------------------------------------------------
// 5. EVENT PARTICIPANTS & QR VERIFICATION SYSTEM
// -------------------------------------------------------------
enum CheckInStatus {
  Unconfirmed
  Confirmed
  Checked_In  @map("Checked In")
  Rejected
}

model EventParticipant {
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  participantCode String?       @map("participant_code") @db.VarChar(50)
  qrToken         String        @unique @map("qr_token") @db.VarChar(255)
  checkInStatus   CheckInStatus @default(Unconfirmed) @map("check_in_status")
  internalNotes   String?       @map("internal_notes")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "unique_event_participant")
  @@index([eventId])
  @@index([userId])
  @@index([qrToken])
  @@map("event_participants")
}

// -------------------------------------------------------------
// 6. EVENT RESOURCES (Resource Vault)
// -------------------------------------------------------------
model EventResource {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  title          String   @db.VarChar(255)
  category       String   @db.VarChar(50)
  fileUrl        String   @map("file_url")
  fileType       String   @map("file_type") @db.VarChar(20)
  fileSizeBytes  BigInt?  @map("file_size_bytes")
  uploadedUserId String?  @map("uploaded_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedUser User? @relation(fields: [uploadedUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("event_resources")
}

// -------------------------------------------------------------
// 7. STAGES (Run of Show)
// -------------------------------------------------------------
enum StageStatus {
  LIVE
  Upcoming
  Completed
}

model Stage {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  stageOrder  Int         @map("stage_order")
  title       String      @db.VarChar(255)
  timeWindow  String      @map("time_window") @db.VarChar(100)
  location    String      @db.VarChar(255)
  ownerTeamId String?     @map("owner_team_id") @db.Uuid
  status      StageStatus @default(Upcoming)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ownerTeam Team? @relation("StageOwnerTeam", fields: [ownerTeamId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("stages")
}

// -------------------------------------------------------------
// 8. TASKS
// -------------------------------------------------------------
enum TaskStatus {
  Todo
  In_Progress @map("In Progress")
  Blocked
  Completed
}

enum PriorityLevel {
  Critical
  High
  Medium
  Low
}

model Task {
  id             String        @id @default(uuid()) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  title          String        @db.VarChar(255)
  description    String?
  teamId         String?       @map("team_id") @db.Uuid
  assignedUserId String?       @map("assigned_user_id") @db.Uuid
  status         TaskStatus    @default(Todo)
  priority       PriorityLevel @default(Medium)
  dueAt          DateTime?     @map("due_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team         Team? @relation("TaskOwnerTeam", fields: [teamId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([assignedUserId])
  @@index([teamId])
  @@map("tasks")
}

// -------------------------------------------------------------
// 9. DUTIES & DUTY ASSIGNMENTS
// -------------------------------------------------------------
model Duty {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  title      String   @db.VarChar(255)
  timeWindow String   @map("time_window") @db.VarChar(100)
  location   String   @db.VarChar(255)
  teamName   String?  @map("team_name") @db.VarChar(100)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments DutyAssignment[]

  @@index([eventId])
  @@map("duties")
}

model DutyAssignment {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  dutyId  String @map("duty_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  duty  Duty  @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dutyId, userId], name: "unique_duty_user")
  @@index([eventId])
  @@index([userId])
  @@map("duty_assignments")
}

// -------------------------------------------------------------
// 10. ISSUES
// -------------------------------------------------------------
enum IssueStatus {
  Open
  In_Progress @map("In Progress")
  Resolved
}

model Issue {
  id                          String        @id @default(uuid()) @db.Uuid
  eventId                     String        @map("event_id") @db.Uuid
  title                       String        @db.VarChar(255)
  description                 String?
  priority                    PriorityLevel @default(Medium)
  status                      IssueStatus   @default(Open)
  reporterUserId              String        @map("reporter_user_id") @db.Uuid
  assignedUserId              String?       @map("assigned_user_id") @db.Uuid
  mandatoryResolutionFeedback String?       @map("mandatory_resolution_feedback")
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt                  DateTime?     @map("resolved_at") @db.Timestamptz

  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporterUser User  @relation("IssueReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  assignedUser User? @relation("IssueAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([reporterUserId])
  @@map("issues")
}
